@model isaacmagazine.Models.LoginViewModel

@{
    ViewBag.Title = "Вход";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow">
                <div class="card-header text-center py-3">
                    <h4 class="mb-0">Вход в систему</h4>
                </div>
                <div class="card-body p-4">
                    <form action="/Account/Login" method="post">
                        @Html.AntiForgeryToken()

                        <div class="mb-3">
                            <label class="form-label fw-bold">Логин</label>
                            <input type="text" name="UserName" class="form-control" placeholder="Введите логин" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Пароль</label>
                            <input type="password" name="Password" class="form-control" placeholder="Введите пароль" required />
                        </div>
                        
                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary btn-lg">Войти</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>