@model isaacmagazine.Models.RegisterViewModel

@{
    ViewBag.Title = "Регистрация";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-success text-white text-center py-3 rounded-top-4">
                    <h4 class="mb-0 fw-bold">📝 Регистрация</h4>
                </div>
                <div class="card-body p-4">
                    <form action="/Account/Register" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div asp-validation-summary="All" class="text-danger mb-3 fw-bold"></div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Email</label>
                            <input type="email" name="Email" class="form-control" placeholder="example@mail.com" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Логин</label>
                            <input type="text" name="UserName" class="form-control" placeholder="Придумайте логин" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Пароль</label>
                            <input type="password" name="Password" class="form-control" placeholder="Минимум 6 символов" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold">Подтверждение пароля</label>
                            <input type="password" name="ConfirmPassword" class="form-control" required />
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-success btn-lg fw-bold">Зарегистрироваться</button>
                        </div>
                    </form>
                    
                    <div class="text-center mt-3">
                        <small class="text-muted">Уже есть аккаунт? <a href="/Account/Login">Войти</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>