@model isaacmagazine.Domain.Entities.Game

@{
    ViewBag.Title = Model.Id == 0 ? "Добавить игру" : "Редактировать игру";
}

<div class="container mt-4">
    <h2 class="mb-4">@ViewBag.Title</h2>

    <!-- Вывод ошибок валидации -->
    <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>

    <form action="/Admin/GamesEdit" method="post" enctype="multipart/form-data" class="card p-4 shadow-sm">
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="DateCreated" value="@Model.DateCreated" />
        <input type="hidden" name="Photo" value="@Model.Photo" />

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-bold">Название игры</label>
                    <input type="text" name="Title" value="@Model.Title" class="form-control" required />
                </div>

                <!-- Выпадающий список Жанров (через foreach) -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Жанр</label>
                    <select name="GenreId" class="form-select">
                        <option value="">-- Выберите жанр --</option>
                        @if (ViewBag.Genres != null)
                        {
                            foreach (var genre in ViewBag.Genres)
                            {
                                // Если ID совпадает с текущим GenreId игры, делаем его выбранным
                                <option value="@genre.Id" selected="@(genre.Id == Model.GenreId)">@genre.Title</option>
                            }
                        }
                    </select>
                </div>

                <!-- Выпадающий список Платформ (жестко прописан) -->
                <div class="mb-3">
                    <label class="form-label fw-bold">Платформа</label>
                    <select name="Platform" class="form-select">
                        <option value="1" selected="@(Model.Platform == isaacmagazine.Domain.Enums.PlatformType.PC)">PC</option>
                        <option value="2" selected="@(Model.Platform == isaacmagazine.Domain.Enums.PlatformType.PlayStation)">PlayStation</option>
                        <option value="3" selected="@(Model.Platform == isaacmagazine.Domain.Enums.PlatformType.Xbox)">Xbox</option>
                        <option value="4" selected="@(Model.Platform == isaacmagazine.Domain.Enums.PlatformType.NintendoSwitch)">Nintendo Switch</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Цена (руб)</label>
                    <div class="input-group">
                        <input type="number" step="0.01" name="Price" value="@Model.Price" class="form-control" required />
                        <span class="input-group-text">₽</span>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label class="form-label fw-bold">Краткое описание</label>
                    <input type="text" name="ShortDescription" value="@Model.ShortDescription" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Полное описание</label>
                    <textarea name="Description" class="form-control" rows="6">@Model.Description</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Обложка игры</label>
                    <input type="file" name="titleImage" accept="image/*" class="form-control" />
                    
                    @if (!string.IsNullOrEmpty(Model.Photo))
                    {
                        <div class="mt-2 text-center">
                            <img src="~/img/@Model.Photo" alt="Обложка" class="img-thumbnail" style="max-height: 150px;" />
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="mt-4 border-top pt-3">
            <button type="submit" class="btn btn-success px-4">💾 Сохранить</button>
            <a href="/Admin/Index" class="btn btn-outline-secondary ms-2">Отмена</a>
        </div>
    </form>
</div>