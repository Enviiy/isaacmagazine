@model IEnumerable<isaacmagazine.Models.GameDto>

@{
    ViewBag.Title = "Каталог игр";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="fw-bold">🎮 Каталог игр</h1>
        <span class="badge bg-primary fs-6">Всего: @Model.Count()</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning text-center p-5">
            <h4>В магазине пока нет игр 😢</h4>
            <p>Зайдите в админку и добавьте первую игру!</p>
            <a href="/Admin/Index" class="btn btn-primary">В админку</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var game in Model)
            {
                <div class="col">
                    <div class="card h-100 shadow-sm border-0 game-card">
                        <!-- Картинка -->
                        <div class="position-relative overflow-hidden" style="height: 220px;">
                            @if (!string.IsNullOrEmpty(game.Photo))
                            {
                                <img src="~/img/@game.Photo" class="card-img-top w-100 h-100" alt="@game.Title" style="object-fit: cover; transition: transform 0.3s;">
                            }
                            else
                            {
                                <div class="bg-secondary text-white d-flex align-items-center justify-content-center h-100">
                                    Нет обложки
                                </div>
                            }
                            
                            <!-- Плашка с платформой -->
                            <span class="position-absolute top-0 end-0 m-2 badge bg-dark shadow">
                                @game.PlatformName
                            </span>
                        </div>

                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title fw-bold text-truncate" title="@game.Title">@game.Title</h5>
                            <p class="card-text text-muted small flex-grow-1">
                                @(string.IsNullOrEmpty(game.ShortDescription) ? "Описание отсутствует..." : game.ShortDescription)
                            </p>
                            
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="badge bg-secondary">@game.GenreName</span>
                                <span class="fs-4 fw-bold text-success">@game.Price ₽</span>
                            </div>
                        </div>
                        
                        <div class="card-footer bg-white border-0 pb-3">
                            <a href="/Games/Show/@game.Id" class="btn btn-outline-primary w-100 fw-bold">Подробнее</a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<!-- Добавим немного CSS прямо на страницу для эффекта зума -->
<style>
    .game-card:hover img {
        transform: scale(1.1);
    }
</style>