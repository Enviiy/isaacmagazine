@{
    ViewBag.Title = "Главная";
}

<div class="p-5 mb-4 bg-dark text-white rounded-3 shadow-lg text-center" style="background: linear-gradient(135deg, #1e3c72 0%, #2a5298 100%);">
    <div class="container-fluid py-5">
        <h1 class="display-3 fw-bold mb-3">🎮 Добро пожаловать в GameStore!</h1>
        <p class="fs-4 mx-auto mb-4" style="max-width: 700px;">
            Лучшие игры для PC и консолей. Погрузись в мир приключений, стратегий и экшенов по самым приятным ценам.
        </p>
        <a href="/Games/Index" class="btn btn-primary btn-lg px-5 py-3 fw-bold rounded-pill shadow">
            Перейти в каталог 🚀
        </a>
    </div>
</div>

<div class="row text-center mt-5">
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm p-4">
            <h3 class="fs-4">🔥 Новинки</h3>
            <p class="text-muted">Самые свежие релизы каждый день.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm p-4">
            <h3 class="fs-4">💎 Лучшие цены</h3>
            <p class="text-muted">Регулярные скидки и акции.</p>
        </div>
    </div>
    <div class="col-md-4 mb-4">
        <div class="card h-100 border-0 shadow-sm p-4">
            <h3 class="fs-4">⚡ Мгновенная выдача</h3>
            <p class="text-muted">Ключ приходит на почту сразу после оплаты.</p>
        </div>
    </div>
</div>