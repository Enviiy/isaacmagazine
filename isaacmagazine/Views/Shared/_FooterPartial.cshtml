@inject IConfiguration config
@{
    AppConfig? appConfig = config.GetSection("Project").Get<AppConfig>();
}

<footer class="mt-5 py-4">
    <div class="container">
        <div class="row">
            <div class="col-md-6 mb-3 mb-md-0">
                <h5>🎮 @appConfig?.company.CompanyName</h5>
                <p class="text-muted small mb-0">Лучший магазин игр в твоем городе.</p>
            </div>
            <div class="col-md-6 text-md-end">
                <h5>Контакты</h5>
                <p class="mb-0">
                    <a href="tel:@appConfig?.company.CompanyPhoneShort" class="text-dark text-decoration-none">
                        📞 @appConfig?.company.CompanyPhone
                    </a>
                </p>
                <p class="mb-0">
                    <a href="mailto:@appConfig?.company.CompanyEmail" class="text-dark text-decoration-none">
                        ✉️ @appConfig?.company.CompanyEmail
                    </a>
                </p>
            </div>
        </div>
        <hr class="border-secondary mt-4 mb-3">
        <div class="text-center text-muted small">
            &copy; @DateTime.Now.Year @appConfig?.company.CompanyName. Все права защищены.
        </div>
    </div>
</footer>