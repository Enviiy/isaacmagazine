@inject IConfiguration config
@{
    AppConfig? appConfig = config.GetSection("Project").Get<AppConfig>();
}

<div class="p-2 m-1">
    <nav class="navbar navbar-expand-lg bg-body-tertiary shadow-sm rounded">
      <div class="container-fluid">
        <!-- Ссылка на главную -->
        <a class="navbar-brand fw-bold text-primary" href="/"> @(appConfig?.company.CompanyName ?? "GameStore")</a>
        
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>
        
        <div class="collapse navbar-collapse" id="navbarNav">
          <div class="navbar-nav me-auto">
            <a class="nav-link active" aria-current="page" href="/">Главная</a>
            <a class="nav-link" href="/Games/Index">Каталог игр</a>
          </div>

          <!-- Блок с кнопками авторизации -->
        <div class="navbar-nav ms-auto align-items-center">
            @if (User.Identity?.IsAuthenticated == true)
            {

                <a href="/Profile/Index" class="navbar-text me-3 text-dark fw-bold text-decoration-none">
                    @User.Identity.Name
                </a>

                <a class="nav-link fw-bold me-3" href="/Cart/Index">🛒 Корзина</a>

                @if (User.IsInRole("admin"))
                {
                    <a class="btn btn-outline-primary btn-sm me-2" href="/Admin/Index">Админ-панель</a>
                }
        
                <form action="/Account/Logout" method="post" class="d-inline">
                    <button type="submit" class="btn btn-outline-danger btn-sm">Выйти</button>
                </form>
            }
            else
            {

                <a class="btn btn-outline-success btn-sm me-2" href="/Account/Register">Регистрация</a>
                <a class="btn btn-primary btn-sm" href="/Account/Login">Войти</a>
            }
        </div>
        </div>
      </div>
    </nav>
</div>