
<!DOCTYPE html>
<html lang="en">
<head>
    @inject IConfiguration config
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    @{
            AppConfig? appConfig = config.GetSection("isaacmagazine").Get<AppConfig>();
     }
    <title>@(ViewBag.Title ?? appConfig?.company.CompanyName)</title>

    @await Html.PartialAsync("_CssPartial")

</head>
<body>

    @await Html.PartialAsync("_HeaderPartial")

    <main>
        <div class="container">
            @RenderBody()
        </div>
    </main>
    
    @await Html.PartialAsync("_FooterPartial")

    @await Html.PartialAsync("_JsPartial")

</body>
</html>